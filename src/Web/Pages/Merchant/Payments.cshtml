@page
@model Web.Pages.Merchant.PaymentsModel
@{
    ViewData["Title"] = "Payments";
    var d = Model.Data;
}

<div class="page-head">
    <div>
        <h1>Payments</h1>
        <p>We pay you every day: the cash collected for you, less our charges.</p>
    </div>
</div>

@if (!d.HasPayoutAccount)
{
    <div class="alert alert-warning">@Icons.Get("wallet")<div>We cannot pay you yet. Add your bKash, Nagad or bank account in <a asp-page="/Merchant/Settings">Settings</a>.</div></div>
}

<div class="stats">
    <div class="stat">
        <div class="stat-icon green">@Icons.Get("cash")</div>
        <div><div class="stat-label">Cash collected, not paid yet</div><div class="stat-value">@Money.Taka(d.Unpaid.Cod)</div></div>
    </div>
    <div class="stat">
        <div class="stat-icon red">@Icons.Get("tag")</div>
        <div><div class="stat-label">Charges to take off</div><div class="stat-value">@Money.Taka(d.Unpaid.Charges)</div></div>
    </div>
    <div class="stat">
        <div class="stat-icon">@Icons.Get("wallet")</div>
        <div>
            <div class="stat-label">Your next payout</div>
            <div class="stat-value @(d.Unpaid.Net < 0 ? "negative" : "")">@Money.Taka(d.Unpaid.Net)</div>
            <div class="stat-sub">@(d.PayoutAccount is null ? "No payout account yet" : $"To {d.PayoutAccount}")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head"><div><h2>Waiting for your next payout</h2><p>@d.Unpaid.Parcels parcels finished and not paid out yet</p></div></div>
    @await Html.PartialAsync("_StatementLines", (d.UnpaidLines, "/Merchant/Parcel/"))
</div>

<div class="card">
    <div class="card-head"><h2>Payouts</h2></div>
    @await Html.PartialAsync("_PayoutTable", (d.Payouts, "/Merchant/Payment/", false))
</div>
