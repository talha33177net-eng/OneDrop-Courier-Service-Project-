@page
@model Web.Pages.Merchant.ApiKeysModel
@using Domain.Merchants
@{
    ViewData["Title"] = "API keys";
}

<div class="page-head">
    <div>
        <h1>API keys</h1>
        <p>Your website books parcels with a key. Make one key per website or app, so you can stop one without stopping the others.</p>
    </div>
</div>

@if (Model.Issued is not null)
{
    <div class="alert alert-success" role="status">
        @Icons.Get("key")
        <div>
            <strong>Your new key.</strong> Copy it now and put it in your website's settings: we will not show it again.
            <p class="mt" style="margin-bottom:0"><code style="font-size:14px;word-break:break-all">@Model.Issued</code></p>
        </div>
    </div>
}
@if (Model.Done is not null)
{
    <div class="alert alert-success" role="status">@Icons.Get("check-circle")<div>@Model.Done</div></div>
}
@if (Model.Problem is not null)
{
    <div class="alert alert-error" role="alert">@Icons.Get("alert")<div>@Model.Problem</div></div>
}

<div class="grid grid-side">
    <div class="card">
        <div class="card-head"><h2>Your keys</h2></div>
        @if (Model.Keys.Count == 0)
        {
            <div class="empty">@Icons.Get("key")<h3>No keys yet</h3><p>Make one with the form.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Name</th><th>Key starts</th><th>Made</th><th>Last used</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var key in Model.Keys)
                        {
                            <tr>
                                <td class="cell-main">@key.Name</td>
                                <td><code>od_@(key.Prefix)_…</code></td>
                                <td class="nowrap">@key.Created.ToString("d MMM yyyy")</td>
                                <td class="nowrap">@(key.LastUsed?.ToString("d MMM HH:mm") ?? "Never")</td>
                                <td>
                                    @if (key.Revoked is { } revoked)
                                    {
                                        <span class="badge badge-cancel">Revoked @revoked.ToString("d MMM")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-done">Active</span>
                                    }
                                </td>
                                <td class="text-right">
                                    @if (key.Revoked is null)
                                    {
                                        <form method="post" asp-page-handler="Revoke" class="inline-form">
                                            <input type="hidden" name="prefix" value="@key.Prefix" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Revoke this key? Calls with it stop working at once.')">Revoke</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-head"><h2>@Icons.Get("plus") Make a new key</h2></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Issue">
                    <div class="field">
                        <label asp-for="Name">What will use it</label>
                        <input asp-for="Name" maxlength="@MerchantApiKey.MaxNameLength" placeholder="My website" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Make the key</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-head"><h2>@Icons.Get("code") For your developer</h2></div>
            <div class="card-body">
                <p>Send the whole key in the <code>X-Api-Key</code> header.</p>
                <dl class="kv">
                    <dt><code>POST</code></dt><dd><code>/api/v1/parcels</code> books a parcel</dd>
                    <dt><code>GET</code></dt><dd><code>/api/v1/parcels/{code}</code> its status</dd>
                    <dt><code>POST</code></dt><dd><code>/api/v1/parcels/{code}/cancel</code></dd>
                    <dt><code>GET</code></dt><dd><code>/api/v1/charge</code> the price before booking</dd>
                    <dt><code>GET</code></dt><dd><code>/api/v1/areas</code> the area list</dd>
                </dl>
                <p class="hint mt">We keep only the start of a key, so a lost key cannot be shown again: make a new one and revoke the old.</p>
            </div>
        </div>
    </div>
</div>
