@page
@model Web.Pages.Merchant.PayoutsModel
@using Domain.Payments
@{
    ViewData["Title"] = "Payouts";
    var money = Model.Money;
}

<p class="eyebrow">@Model.MerchantName</p>
<h1>Payouts</h1>
<p class="lead">
    The cash on delivery OneDrop collects for you is paid to your bKash the day after delivery.
</p>

<details class="help">
    <summary>What is added and what is taken off</summary>
    <ul>
        <li><strong>Cash on delivery</strong>: the product money the rider collected for you. Added.</li>
        <li><strong>Return charge</strong>: a parcel the customer refused, or nobody was home twice, goes back to you. Taken off.</li>
        <li><strong>Not ready at pickup</strong>: an order not handed to the collector in time needs a second trip. Taken off.</li>
        <li>When the charges are more than a day's cash on delivery, the rest comes off the next payout. The delivery fee is the customer's, never yours.</li>
    </ul>
</details>

<div class="card">
    <dl class="money">
        <div class="total">
            <dt>@(money.Balance < 0 ? "You owe, taken off your next COD" : "Next payout, so far")</dt>
            <dd>৳@Math.Abs(money.Balance).ToString("N0")</dd>
        </div>
    </dl>
    @if (money.Waiting.Count == 0)
    {
        <p class="muted">Nothing waiting to be paid out.</p>
    }
    else
    {
        <partial name="_PayoutLines" model="money.Waiting" />
    }
</div>

<h2 class="section-title">Paid out</h2>
@if (money.Payouts.Count == 0)
{
    <div class="card"><p class="muted">No payouts yet.</p></div>
}
@foreach (var payout in money.Payouts)
{
    <section class="card">
        <div class="stop-head">
            <div>
                <h2>৳@payout.Amount.ToString("N0")</h2>
                <div class="muted">
                    Up to @payout.UpTo.ToString("ddd d MMM"), to bKash @payout.Account
                    @if (payout.PaidOn is { } paidOn)
                    {
                        <text>· sent @paidOn.ToString("d MMM HH:mm") UTC</text>
                    }
                </div>
            </div>
            @if (payout.Status == SettlementStatus.Paid)
            {
                <span class="pill pill-ready">Paid</span>
            }
            else
            {
                <span class="pill pill-waiting">Sending</span>
            }
        </div>
        <partial name="_PayoutLines" model="payout.Lines" />
    </section>
}
