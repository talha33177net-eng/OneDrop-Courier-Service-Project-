@page
@model Web.Pages.Merchant.LabelsModel
@{
    ViewData["Title"] = "Print labels";
}

<div class="page-head no-print">
    <div>
        <h1>Print labels</h1>
        <p>@(Model.Codes.Length > 0 ? $"{Model.Labels.Count} chosen parcels." : $"Every parcel waiting for pickup: {Model.Labels.Count}.") Stick one on each parcel before the rider comes.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" type="button" onclick="window.print()">@Icons.Get("printer") Print</button>
    </div>
</div>

@if (Model.Labels.Count == 0)
{
    <div class="card">
        <div class="empty">
            @Icons.Get("printer")
            <h3>No labels to print</h3>
            <p>Labels are printed for parcels waiting for pickup. <a asp-page="/Merchant/NewParcel">Book a parcel</a> first.</p>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("_Labels", (Model.Labels, Model.Courier, Model.Hotline))
}
