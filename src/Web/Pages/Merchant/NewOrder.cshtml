@page
@model Web.Pages.Merchant.NewOrderModel
@{
    ViewData["Title"] = "New order";
    var tenant = Model.Tenant;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Shop</p>
        <h1>New order</h1>
        <p class="lead">
            For an order taken by phone or Facebook. Orders from your website arrive by themselves. The customer pays the
            delivery fee at the door; you pay nothing.
        </p>
    </div>
    <a class="button ghost" asp-page="/Merchant/Orders">My orders</a>
</div>

@if (Model.CreatedNumber is not null)
{
    <section class="card scan-result" role="status">
        <div class="scan-label">Order created</div>
        <div class="scan-big">@Model.CreatedNumber</div>
        <p>@Model.CreatedMessage</p>
        <div class="door-actions">
            <a class="button" asp-page="/Merchant/Labels" asp-route-order="@Model.CreatedNumber">Print its labels</a>
            <a class="button ghost" href="#form">Add another order</a>
        </div>
    </section>
}

@if (Model.Problems.Count > 0)
{
    <div class="notice notice-problem" role="alert">
        <strong>The order was not saved. Please check:</strong>
        <ul>
            @foreach (var problem in Model.Problems)
            {
                <li>@problem</li>
            }
        </ul>
    </div>
}

<form method="post" id="form">
    <input asp-for="Form.Key" type="hidden" />

    <section class="card">
        <h2><span class="step-no">1</span> Who is it for?</h2>
        <div class="cards">
            <div>
                <label asp-for="Form.Name">Customer name</label>
                <input asp-for="Form.Name" type="text" autocomplete="off" required />
            </div>
            <div>
                <label asp-for="Form.Phone">Mobile number</label>
                <input asp-for="Form.Phone" type="tel" inputmode="tel" placeholder="01712345678" required />
            </div>
        </div>
        <p class="muted">The mobile number is how OneDrop finds the customer's other orders to deliver together.</p>
    </section>

    <section class="card">
        <h2><span class="step-no">2</span> Where to?</h2>
        <label asp-for="Form.AreaId">Area</label>
        <select asp-for="Form.AreaId" class="select" required>
            <option value="">Choose the area…</option>
            @foreach (var zone in Model.Areas.GroupBy(area => area.Zone))
            {
                <optgroup label="@zone.Key">
                    @foreach (var area in zone)
                    {
                        <option value="@area.Id">@area.Name</option>
                    }
                </optgroup>
            }
        </select>
        <label asp-for="Form.Line1">House, road</label>
        <input asp-for="Form.Line1" type="text" placeholder="House 12, Road 5" required />
        <div class="cards">
            <div>
                <label asp-for="Form.Line2">Flat, floor <span class="muted">(optional)</span></label>
                <input asp-for="Form.Line2" type="text" placeholder="Flat 3B" />
            </div>
            <div>
                <label asp-for="Form.Landmark">Landmark <span class="muted">(optional)</span></label>
                <input asp-for="Form.Landmark" type="text" placeholder="Near the mosque" />
            </div>
        </div>
    </section>

    <section class="card">
        <h2><span class="step-no">3</span> What is in it?</h2>
        <div class="cards">
            <div>
                <label asp-for="Form.Description">What it is</label>
                <input asp-for="Form.Description" type="text" />
            </div>
            <div>
                <label asp-for="Form.Parcels">Number of parcels</label>
                <input asp-for="Form.Parcels" type="number" min="1" max="20" class="number" />
            </div>
            <div>
                <label asp-for="Form.WeightKg">Weight of each parcel (kg)</label>
                <input asp-for="Form.WeightKg" type="number" min="0.1" max="20" step="0.1" class="number" />
            </div>
            <div>
                <label asp-for="Form.Cod">Cash on delivery (৳)</label>
                <input asp-for="Form.Cod" type="number" min="0" step="1" class="number" />
            </div>
        </div>
        <p class="muted">
            Cash on delivery is the product money the rider collects for you; put 0 when the customer already paid
            online. It is paid to you the day after delivery. Each shop's parcels include
            @((tenant.WeightAllowanceGrams / 1000m).ToString("0.#")) kg; each started kg above adds
            ৳@tenant.ExtraKgFee.ToString("N0") to the customer's fee.
        </p>
    </section>

    <section class="card">
        <h2><span class="step-no">4</span> How fast?</h2>
        <label class="check"><input asp-for="Form.Fast" /> <span><strong>Deliver fast</strong>: next day, without waiting for other shops. The customer pays ৳@tenant.FastDeliveryFee.ToString("N0") instead of ৳@tenant.BaseDeliveryFee.ToString("N0").</span></label>
        <label class="check"><input asp-for="Form.DoNotHold" /> <span><strong>Don't hold</strong>: food, medicine or a dated gift. Goes next day at the normal fee.</span></label>
        <label class="check"><input asp-for="Form.FeeInAdvance" /> <span><strong>Ask for the delivery fee in advance</strong>: for a customer you do not trust. We collect the parcel only once they have paid.</span></label>
        <p class="muted">Leave all three unticked to let the order wait for the customer's other shops: the cheapest for them.</p>
    </section>

    <details class="help">
        <summary>Optional: your own order number and a note</summary>
        <div class="card">
            <label asp-for="Form.Reference">Your order number</label>
            <input asp-for="Form.Reference" type="text" />
            <label asp-for="Form.Note">Note for the rider</label>
            <input asp-for="Form.Note" type="text" />
        </div>
    </details>

    <button class="button big" type="submit">Create order</button>
</form>
