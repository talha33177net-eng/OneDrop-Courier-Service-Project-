@page
@using Domain.Merchants
@model Web.Pages.Merchant.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var a = Model.Account;
}

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p>Your business, where we pay you, and where we pick up your parcels.</p>
    </div>
    <div>@Statuses.Badge(a.Status)</div>
</div>

<partial name="_Alerts" />

<div class="grid grid-2">
    <div class="card">
        <div class="card-head"><h2>@Icons.Get("store") Business profile</h2></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Profile">
                <div class="field"><label for="name">Business name</label><input type="text" id="name" name="name" value="@a.Profile.Name" required /></div>
                <div class="field"><label for="owner">Owner's name</label><input type="text" id="owner" name="owner" value="@a.Profile.OwnerName" required /></div>
                <div class="form-grid">
                    <div class="field"><label for="phone">Mobile number</label><input type="tel" id="phone" name="phone" value="@Money.Phone(a.Profile.Phone)" required /></div>
                    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="@a.Profile.Email" /></div>
                </div>
                <div class="field"><label for="address">Business address</label><input type="text" id="address" name="address" value="@a.Profile.Address" required /></div>
                <button class="btn btn-primary" type="submit">Save profile</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h2>@Icons.Get("wallet") Payout account</h2></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Payout">
                <div class="field">
                    <label>Pay me by</label>
                    <div class="radio-cards">
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Bkash" checked="@(a.PayoutMethod is null or PayoutMethod.Bkash)" /> bKash<small>Personal or merchant number</small></label>
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Nagad" checked="@(a.PayoutMethod == PayoutMethod.Nagad)" /> Nagad<small>Personal or merchant number</small></label>
                        <label class="radio-card"><input type="radio" name="method" value="@PayoutMethod.Bank" checked="@(a.PayoutMethod == PayoutMethod.Bank)" /> Bank<small>Transfer to an account</small></label>
                    </div>
                </div>
                <div class="field">
                    <label for="payoutAccount">Number or account number</label>
                    <input type="text" id="payoutAccount" name="payoutAccount" value="@(a.PayoutMethod == PayoutMethod.Bank ? a.PayoutAccount : Money.Phone(a.PayoutAccount))" required />
                </div>
                <div class="field">
                    <label for="accountName">Account name</label>
                    <input type="text" id="accountName" name="accountName" value="@a.PayoutAccountName" required />
                    <span class="hint">For a bank, also write the bank and branch.</span>
                </div>
                <button class="btn btn-primary" type="submit">Save payout account</button>
            </form>
        </div>
    </div>
</div>

<div class="card mt-lg">
    <div class="card-head"><div><h2>@Icons.Get("map-pin") Pickup points</h2><p>Where riders collect your parcels. New parcels go from the default point unless you choose another.</p></div></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Name</th><th>Address</th><th>Area</th><th>Phone</th><th></th></tr></thead>
            <tbody>
                @foreach (var point in a.PickupPoints)
                {
                    <tr>
                        <td class="cell-main">@point.Name @if (point.IsDefault) { <span class="badge badge-brand plain">Default</span> }</td>
                        <td>@point.Address</td>
                        <td>@point.Area</td>
                        <td>@Money.Phone(point.ContactPhone)</td>
                        <td class="text-right">
                            @if (!point.IsDefault)
                            {
                                <form method="post" asp-page-handler="Default" asp-route-id="@point.Id" class="inline-form">
                                    <button class="btn btn-ghost btn-sm" type="submit">Make default</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body" style="border-top:1px solid var(--line)">
        <h3 class="mb">Add a pickup point</h3>
        <form method="post" asp-page-handler="Point">
            <div class="form-grid">
                <div class="field"><label for="pname">Name</label><input type="text" id="pname" name="name" placeholder="e.g. Warehouse" required /></div>
                <div class="field"><label for="areaId">Area</label>@await Html.PartialAsync("_AreaSelect", ("areaId", (long?)null, Model.Areas))</div>
                <div class="field"><label for="paddress">Address</label><input type="text" id="paddress" name="address" required /></div>
                <div class="field"><label for="pphone">Contact phone</label><input type="tel" id="pphone" name="phone" required /></div>
            </div>
            <button class="btn btn-outline" type="submit">@Icons.Get("plus") Add pickup point</button>
        </form>
    </div>
</div>
