@page
@model Web.Pages.Merchant.WebhookModel
@{
    ViewData["Title"] = "Webhooks";
    var settings = Model.Settings;
}

<div class="page-head">
    <div>
        <h1>Webhooks</h1>
        <p>Your website hears each time one of your parcels moves on. We post it to your address, signed so you know it is ours.</p>
    </div>
</div>

@if (Model.Done is not null)
{
    <div class="alert @(Model.DoneOk ? "alert-success" : "alert-error")" role="status">@Icons.Get(Model.DoneOk ? "check-circle" : "alert")<div>@Model.Done</div></div>
}
@if (Model.Problem is not null)
{
    <div class="alert alert-error" role="alert">@Icons.Get("alert")<div>@Model.Problem</div></div>
}

<div class="grid grid-main">
    <div class="stack">
        <div class="card">
            <div class="card-head"><h2>@Icons.Get("zap") Your website's address</h2></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save">
                    <div class="field">
                        <label asp-for="Address">Webhook address</label>
                        <input asp-for="Address" type="url" inputmode="url" placeholder="https://myshop.com.bd/courier/webhook" required />
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
                @if (settings.Url is not null)
                {
                    <hr />
                    <div class="spread">
                        <span class="muted">Updates go to <strong>@settings.Url</strong></span>
                        <span class="gap">
                            <form method="post" asp-page-handler="Test" class="inline-form"><button type="submit" class="btn btn-outline btn-sm">Send a test</button></form>
                            <form method="post" asp-page-handler="Remove" class="inline-form"><button type="submit" class="btn btn-danger btn-sm">Stop sending</button></form>
                        </span>
                    </div>
                }
            </div>
        </div>

        @if (settings.Secret is not null)
        {
            <div class="card">
                <div class="card-head"><h2>@Icons.Get("lock") Your secret</h2></div>
                <div class="card-body">
                    <p>Your website checks each update's signature with this. Keep it on your server; never put it in a web page.</p>
                    <p><code style="word-break:break-all">@settings.Secret</code></p>
                    <form method="post" asp-page-handler="Secret">
                        <button type="submit" class="btn btn-outline btn-sm">Make a new secret</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-head"><h2>@Icons.Get("code") What your website receives</h2></div>
        <div class="card-body">
            <p>A <strong>POST</strong> with a JSON body, one per change:</p>
            <pre style="background:var(--grey-soft);padding:12px;border-radius:8px;overflow:auto;font-size:12px"><code>{
  "type": "parcel.status_changed",
  "timestamp": "2026-10-04T11:32:05Z",
  "data": {
    "trackingCode": "OD10000001",
    "merchantReference": "INV-1042",
    "status": "delivered",
    "codAmount": 1250,
    "collectedAmount": 1250,
    "deliveryCharge": 60,
    "reason": null
  }
}</code></pre>
            <p class="hint">Statuses: <code>pickedUp</code>, <code>atHub</code>, <code>inTransit</code>, <code>outForDelivery</code>, <code>onHold</code>, <code>delivered</code>, <code>partlyDelivered</code>, <code>returning</code>, <code>returned</code>, <code>cancelled</code>.</p>
            <p class="hint">Headers follow <a href="https://www.standardwebhooks.com/" rel="noopener">Standard Webhooks</a>: <code>webhook-id</code>, <code>webhook-timestamp</code>, <code>webhook-signature</code>. Answer with a 2xx status; otherwise we try again after 1, 2, 4 and 8 minutes.</p>
        </div>
    </div>
</div>
