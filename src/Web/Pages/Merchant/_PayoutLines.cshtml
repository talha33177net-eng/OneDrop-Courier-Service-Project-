@model IReadOnlyList<Application.Payments.MerchantPayouts.PayoutLine>
@using Domain.Payments

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Day</th>
                <th>Order</th>
                <th>For</th>
                <th class="num">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <td>@line.Day.ToString("ddd d MMM")</td>
                    <td><strong>@line.Order</strong></td>
                    <td>
                        @(line.Kind switch
                        {
                            LedgerEntryKind.Cod => "Cash on delivery",
                            LedgerEntryKind.ReturnCharge => "Return charge",
                            _ => "Not ready at pickup"
                        })
                    </td>
                    <td class="num">
                        @if (line.Amount < 0)
                        {
                            <text>−৳@((-line.Amount).ToString("N0"))</text>
                        }
                        else
                        {
                            <text>৳@line.Amount.ToString("N0")</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
