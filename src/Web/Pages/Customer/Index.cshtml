@page
@model Web.Pages.Customer.IndexModel
@using Application.Grouping.CustomerDeliveries
@using Domain.Grouping
@using Domain.Orders
@using Web.Display
@{
    ViewData["Title"] = "My deliveries";
    var deliveries = Model.Deliveries;
    string[] stages = ["Shops joining", "Closed", "Collected", "On the way", "Delivered"];
}

@section Head {
    <partial name="_CustomerApp" />
}

<h1>My deliveries</h1>
<p class="lead">Orders from every shop that chose OneDrop for you. Orders to the same address travel together.</p>

<details class="help">
    <summary>How your deliveries work</summary>
    <ol>
        <li>Your first OneDrop order opens a delivery to that address.</li>
        <li>Until its last day to join, orders from other shops ride along for only +৳@deliveries.ExtraShopFee.ToString("N0") each.</li>
        <li>Then it closes, the shops' parcels are collected, and one rider brings them all on the delivery day.</li>
        <li>Pay the delivery fee and any cash on delivery at the door, in cash or by bKash or Nagad.</li>
    </ol>
</details>

@if (Model.Message is not null)
{
    <p class="notice notice-ok">@Model.Message</p>
}

@if (deliveries.OnTheWay.Count == 0)
{
    <div class="card">
        <p class="muted">Nothing on its way yet. Choose OneDrop at checkout and your orders appear here.</p>
    </div>
}

@foreach (var delivery in deliveries.OnTheWay)
{
    var open = delivery.Status == DeliveryGroupStatus.Open;
    var stage = Stage(delivery);
    <article class="card delivery">
        <div class="delivery-head">
            <span class="pill @(open ? "pill-open" : null)">@Statuses.Delivery(delivery.Status)</span>
            <span class="muted">@delivery.Number</span>
        </div>
        <h2>@Arrival(delivery)</h2>
        <p class="muted">
            To @delivery.Address.
            @if (open)
            {
                <br />
                @:Other shops can join until the end of @delivery.LastDayToJoin.ToString("dddd d MMMM").
            }
        </p>

        @if (delivery.SameAddress is { } same)
        {
            <form method="post" class="notice same-address">
                <input type="hidden" name="number" value="@delivery.Number" />
                <strong>Same address as your delivery @same.OtherDelivery?</strong>
                <p>
                    That one goes to @same.OtherAddress. If it is the same place, we bring both together on
                    @same.CombinedDay.ToString("dddd d MMMM") for one delivery fee, and remember this spelling.
                </p>
                <div class="same-address-buttons">
                    <button class="button" type="submit" asp-page-handler="Combine">Same address: combine</button>
                    <button class="button secondary" type="submit" asp-page-handler="KeepSeparate">Different place: keep separate</button>
                </div>
            </form>
        }

        @if (stage > 0)
        {
            <ol class="tracker" aria-label="Progress">
                @for (var step = 1; step <= stages.Length; step++)
                {
                    <li class="@(step < stage ? "done" : step == stage ? "now" : null)" aria-current="@(step == stage ? "step" : null)">@stages[step - 1]</li>
                }
            </ol>
        }

        <ul class="lines">
            @foreach (var order in delivery.Orders)
            {
                <li class="@(Order.IsForDelivery(order.Status) ? null : "dropped")">
                    <div>
                        <strong>@order.Shop</strong>
                        <span class="muted">@order.Number · @(order.Packages == 1 ? "1 package" : $"{order.Packages} packages")</span>
                    </div>
                    <span class="@Statuses.OrderClass(order.Status)">@Statuses.Order(order.Status)</span>
                </li>
            }
        </ul>

        <div class="collected">
            <span>Packages collected from the shops</span>
            <strong>@delivery.PackagesCollected of @delivery.Packages</strong>
        </div>
        <progress max="@Math.Max(delivery.Packages, 1)" value="@delivery.PackagesCollected">@delivery.PackagesCollected of @delivery.Packages</progress>

        <dl class="money">
            <div>
                <dt>@(open ? "Delivery fee so far" : "Delivery fee")</dt>
                <dd>৳@delivery.Fee.ToString("N0")</dd>
            </div>
            @if (delivery.Cod > 0)
            {
                <div>
                    <dt>Cash on delivery for the shops</dt>
                    <dd>৳@delivery.Cod.ToString("N0")</dd>
                </div>
                <div class="total">
                    <dt>To pay at the door</dt>
                    <dd>৳@((delivery.Fee + delivery.Cod).ToString("N0"))</dd>
                </div>
            }
        </dl>
        @if (delivery.Savings > 0)
        {
            <p class="saving">You save ৳@delivery.Savings.ToString("N0") against @delivery.Shops.Count separate deliveries.</p>
        }

        @if (open)
        {
            <p class="muted">
                Buying from another shop before then? Choose OneDrop at checkout: it adds only
                ৳@deliveries.ExtraShopFee.ToString("N0") to this delivery.
            </p>
            <form method="post" asp-page-handler="ShipNow" class="ship-now">
                <strong>In a hurry?</strong>
                <input type="hidden" name="number" value="@delivery.Number" />
                @if (delivery.ShipNowFee > 0)
                {
                    <span class="muted">Don't wait for more shops: we deliver tomorrow instead of @delivery.DeliveryDay.ToString("dddd").</span>
                    <br />
                    <button class="button" type="submit">Deliver tomorrow for +৳@delivery.ShipNowFee.Value.ToString("N0")</button>
                }
                else
                {
                    <span class="muted">Don't wait for more shops: no one else can join, and we still deliver tomorrow.</span>
                    <br />
                    <button class="button" type="submit">Ship now</button>
                }
            </form>
        }
    </article>
}

@if (deliveries.Earlier.Count > 0)
{
    <h2 class="section-title">Earlier deliveries</h2>
    <div class="card">
        <ul class="lines">
            @foreach (var delivery in deliveries.Earlier)
            {
                <li>
                    <div>
                        <strong>@delivery.DeliveryDay.ToString("d MMMM")</strong>
                        <span class="muted">@delivery.Number · @string.Join(", ", delivery.Shops.DefaultIfEmpty("no shops"))</span>
                    </div>
                    <span class="status @(delivery.Status == DeliveryGroupStatus.Delivered ? "status-done" : "status-quiet")">@Statuses.Delivery(delivery.Status)@(delivery.Fee > 0 ? $" · ৳{delivery.Fee:N0}" : null)</span>
                </li>
            }
        </ul>
    </div>
}

@functions {
    private static string Arrival(CustomerDelivery delivery)
    {
        return delivery.Status == DeliveryGroupStatus.Dispatched
            ? "Out for delivery today"
            : $"Arriving {delivery.DeliveryDay:dddd d MMMM}";
    }

    /// <summary>Where the delivery is on the tracker (1 to 5), or 0 when it has none (cancelled).</summary>
    private static int Stage(CustomerDelivery delivery)
    {
        return delivery.Status switch
        {
            DeliveryGroupStatus.Open => 1,
            DeliveryGroupStatus.Locked => delivery.PackagesCollected < delivery.Packages ? 2 : 3,
            DeliveryGroupStatus.Dispatched => 4,
            DeliveryGroupStatus.Delivered => 5,
            _ => 0
        };
    }
}
