@page
@{
    ViewData["Title"] = "Error";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <div class="stat-icon red" style="margin:0 auto 14px">@Icons.Get("alert")</div>
        <h1>Something went wrong</h1>
        <p class="sub">The problem has been logged. Please try again in a moment.</p>
        <a class="btn btn-primary" href="/">Back to the start</a>
    </div>
</div>
