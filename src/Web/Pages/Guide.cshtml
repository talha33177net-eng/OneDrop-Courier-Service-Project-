@page
@model GuideModel
@{
    ViewData["Title"] = "How it works";
    var tenant = Model.Tenant;
}

<p class="eyebrow">How it works</p>
<h1>One delivery, from the shop to the payout</h1>
<p class="lead">
    Follow one customer's delivery through every screen. Each step says who does it and where to click.
    @if (Model.Demo)
    {
        <text>
            In this demo you play every part yourself: sign in as each person with one press on the
            <a asp-page="/Account/Login">sign-in page</a>, and read the customer's texts in the <a asp-page="/Dev/Sms">SMS inbox</a>.
        </text>
    }
</p>

@if (tenant is null)
{
    <div class="notice">
        Everything below happens on an operator's own address. Open one first:
        @foreach (var (operatorInfo, url) in Model.Tenants)
        {
            <a href="@url/Guide">@operatorInfo.Name</a>
        }
    </div>
}

<ol class="flow">
    <li class="flow-step">
        <span class="step-no">1</span>
        <div class="flow-body">
            <span class="flow-who">Shop</span>
            <h3>Two shops take orders for the same customer</h3>
            <p>
                A shop's website sends orders by itself. By hand: <strong>New order</strong>, fill in the customer's
                mobile number and address, <strong>Create order</strong>. Then sign in as a second shop and create an
                order for the <em>same</em> mobile number and address. OneDrop puts both in one delivery: the second
                shop adds only @(tenant is null ? "the extra-shop fee" : $"+৳{tenant.ExtraShopFee:N0}").
            </p>
            @if (Model.Demo)
            {
                <div class="flow-facts"><span class="pill">Demo: @Model.Login("fashion"), then @Model.Login("gadget")</span></div>
            }
        </div>
        <div class="flow-action"><a class="button" asp-page="/Merchant/NewOrder">New order</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">2</span>
        <div class="flow-body">
            <span class="flow-who">Shop</span>
            <h3>Print the labels</h3>
            <p>
                <strong>Print labels</strong> gives one QR label per parcel, such as <code>OD-100080-1</code>. Keep the
                code: the hub scans it in the next steps.
            </p>
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Merchant/Labels">Print labels</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">3</span>
        <div class="flow-body">
            <span class="flow-who">Customer</span>
            <h3>The customer confirms and follows the delivery</h3>
            <p>
                A new customer gets an SMS with a link to confirm the order with one tap. With
                <strong>Track my delivery</strong> and the code from the SMS they see one delivery with both shops, the
                fee, what they save, and a tracker. <strong>Ship now</strong> closes it early.
            </p>
            @if (Model.Demo)
            {
                <div class="flow-facts"><span class="pill">Demo: the texts and codes are in the SMS inbox</span></div>
            }
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Account/PhoneLogin">Track my delivery</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">4</span>
        <div class="flow-body">
            <span class="flow-who">Hub staff · pickup</span>
            <h3>Collect the parcels from the shops</h3>
            <p>
                <strong>Hub today</strong> shows the hub's day in six steps. Step 1, <strong>Pick up from shops</strong>,
                opens each zone's route sheet. At the shop, <strong>Scan parcels</strong> → <strong>Collect at the
                shop</strong> and type or scan each label.
            </p>
            @if (Model.Demo)
            {
                <div class="flow-facts"><span class="pill">Demo: @Model.Login("hub")</span></div>
            }
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Hub/Index">Hub today</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">5</span>
        <div class="flow-body">
            <span class="flow-who">Hub staff · hub</span>
            <h3>Scan them in: one shelf per delivery</h3>
            <p>
                <strong>Scan parcels</strong> → <strong>Receive at the hub</strong>. The answer is the shelf, such as
                <strong>MIR-01</strong>: both shops' parcels go on the same shelf. A parcel for another hub's area says
                "Send on" and goes on the <strong>Shuttle</strong>.
            </p>
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Hub/Scan">Scan parcels</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">6</span>
        <div class="flow-body">
            <span class="flow-who">Hub staff · delivery day</span>
            <h3>Send the riders out</h3>
            <p>
                On the delivery day, closed deliveries with parcels on their shelf go on a rider's trip by themselves, or
                at once with <strong>Plan trips now</strong> on <strong>Send riders out</strong>.
            </p>
            @if (Model.Demo)
            {
                <p class="muted">
                    Demo tip: a delivery goes out on its delivery day, the day after it closes at the earliest (Ship
                    now or Deliver fast). Until then it waits on its shelf and no trip is planned.
                </p>
            }
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Hub/Trips">Riders and trips</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">7</span>
        <div class="flow-body">
            <span class="flow-who">Rider</span>
            <h3>Deliver door to door</h3>
            <p>
                <strong>Today's trip</strong> lists the stops. Take the deliveries off their shelves and start the trip.
                At each door: <strong>At the door</strong>, tick anything refused, collect the amount shown in cash or
                by a bKash or Nagad QR, then hand over. No fee, no handover. Nobody home? One free try another day.
            </p>
            @if (Model.Demo)
            {
                <div class="flow-facts">
                    <span class="pill">Demo: @Model.Login("rider")</span>
                    <span class="pill">Pay a QR on the bKash / Nagad wallet page</span>
                </div>
            }
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Rider/Index">Today's trip</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">8</span>
        <div class="flow-body">
            <span class="flow-who">Hub staff · evening</span>
            <h3>Count the rider's cash</h3>
            <p>Back at the hub, <strong>Riders' cash</strong>: type what the rider handed in and press <strong>Record</strong>.</p>
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Hub/Cash">Riders' cash</a></div>
    </li>
    <li class="flow-step">
        <span class="step-no">9</span>
        <div class="flow-body">
            <span class="flow-who">Shop · next day</span>
            <h3>The shops are paid</h3>
            <p>
                Each shop's cash on delivery is paid to its bKash the next day, less any return charges.
                <strong>Payouts</strong> shows what is coming and what was paid.
            </p>
        </div>
        <div class="flow-action"><a class="button ghost" asp-page="/Merchant/Payouts">Payouts</a></div>
    </li>
</ol>

<h2 class="section-title">Who sees what</h2>
<div class="card table-wrap">
    <table>
        <thead>
            <tr><th>Who</th><th>Signs in with</th><th>Their pages</th></tr>
        </thead>
        <tbody>
            <tr><td><strong>Customer</strong></td><td>Mobile number and SMS code</td><td>My deliveries</td></tr>
            <tr><td><strong>Shop</strong></td><td>Email and password</td><td>My orders, New order, Print labels, Payouts. Only its own orders, never the customer's other shops</td></tr>
            <tr><td><strong>Hub staff</strong></td><td>Email and password</td><td>Hub today and its six steps</td></tr>
            <tr><td><strong>Rider</strong></td><td>Email and password</td><td>Today's trip</td></tr>
            <tr><td><strong>Operator admin</strong></td><td>Email and password</td><td>The operator's live dashboard (every hub, packages per delivery), and everything hub staff see</td></tr>
        </tbody>
    </table>
</div>
