@page
@model Web.Pages.Hub.CashModel
@using Domain.Delivery
@{
    ViewData["Title"] = Model.Current is null ? "Riders' cash" : $"{Model.Current.Name} riders' cash";
    var today = Model.Today;
}

@if (Model.Current is null)
{
    <partial name="_HubPicker" model='new Web.Pages.Hub.HubPicker("/Hub/Cash", "Riders’ cash", "Which hub are you working at?", Model.Hubs)' />
    return;
}

<p class="eyebrow">Step 6 · @Model.Current.Name · @today.Day.ToString("dddd d MMMM")</p>
<h1>Riders' cash</h1>
<p class="lead">
    Count the cash each rider brings back once every stop is done and record what you received. bKash and Nagad
    payments are already with OneDrop.
</p>

<details class="help">
    <summary>How to record a rider's cash</summary>
    <ol>
        <li>Wait until the rider's trip shows the <strong>Record</strong> box (every stop done). "Still out" means they are on the road.</li>
        <li>Count the notes, type the amount you counted (it starts at what they should have) and press <strong>Record</strong>.</li>
        <li>Any difference shows as "short" or "over". Shops are paid the next day either way.</li>
    </ol>
</details>

@if (Model.Message is not null)
{
    <p class="notice notice-ok">@Model.Message</p>
}
@if (Model.Problem is not null)
{
    <p class="notice notice-problem">@Model.Problem</p>
}

<div class="card">
    @if (today.Trips.Count == 0)
    {
        <p class="muted">No rider has collected cash today.</p>
    }
    else
    {
        <dl class="money">
            <div class="total">
                <dt>Still with the riders</dt>
                <dd>৳@today.StillWithRiders.ToString("N0")</dd>
            </div>
        </dl>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Rider</th>
                        <th>Day</th>
                        <th class="num">Cash collected</th>
                        <th class="num">Handed in</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trip in today.Trips)
                    {
                        <tr>
                            <td><strong>@trip.Rider</strong></td>
                            <td>@trip.Day.ToString("ddd d MMM")</td>
                            <td class="num">৳@trip.Cash.ToString("N0")</td>
                            <td class="num">
                                @if (trip.HandedIn is { } handedIn)
                                {
                                    <text>৳@handedIn.ToString("N0")</text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td>
                                @if (trip.HandedIn is not null)
                                {
                                    @if (trip.Short > 0)
                                    {
                                        <span class="pill pill-waiting">৳@trip.Short.Value.ToString("N0") short</span>
                                    }
                                    else if (trip.Short < 0)
                                    {
                                        <span class="pill pill-open">৳@((-trip.Short.Value).ToString("N0")) over</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-ready">Handed in</span>
                                    }
                                }
                                else if (trip.Status != TripStatus.Finished)
                                {
                                    <span class="muted">Still out</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="HandIn" asp-route-hub="@Model.Current.Code" class="cash-form">
                                        <input type="hidden" name="trip" value="@trip.Id" />
                                        <label class="sr-only" for="received-@trip.Id">Cash received from @trip.Rider</label>
                                        <input id="received-@trip.Id" type="number" name="received" min="0" step="1" inputmode="numeric" value="@trip.Cash.ToString("0")" />
                                        <button class="button" type="submit">Record</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
