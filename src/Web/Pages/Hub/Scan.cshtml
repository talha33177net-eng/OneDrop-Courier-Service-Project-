@page
@using Application.Hubs.HubScan
@model Web.Pages.Hub.ScanModel
@{
    ViewData["Title"] = "Scan parcels";
    (ScanMode Mode, string Name, string Icon, string Help)[] modes =
    [
        (ScanMode.Receive, "Receive", "inbox", "A parcel arrives: from a pickup, from another hub, or back from a rider."),
        (ScanMode.Dispatch, "Send to another hub", "send", "A parcel leaves for the hub that delivers it, or a return for the hub that collected it."),
        (ScanMode.HandBack, "Hand back to merchant", "return", "A returning parcel goes back to its merchant here.")
    ];
    var current = modes.Single(m => m.Mode == Model.Mode);
}

<div class="page-head">
    <div>
        <h1>Scan parcels</h1>
        <p>@current.Help</p>
    </div>
    <div class="page-actions">
        @await Html.PartialAsync("_HubSwitch", (Model.Hubs, Model.Hub))
    </div>
</div>

<div class="segmented mb">
    @foreach (var mode in modes)
    {
        <a class="@(mode.Mode == Model.Mode ? "active" : "")" asp-page="/Hub/Scan" asp-route-mode="@mode.Mode" asp-route-hub="@Model.Hub?.Code">@Icons.Get(mode.Icon) @mode.Name</a>
    }
</div>

<div class="card">
    <div class="card-body">
        <form method="post" asp-route-mode="@Model.Mode" asp-route-hub="@Model.Hub?.Code" class="scan-box">
            <input asp-for="Code" autofocus autocomplete="off" placeholder="Scan or type the tracking code" aria-label="Tracking code" />
            <button class="btn btn-primary" type="submit">@Icons.Get(current.Icon) @current.Name</button>
        </form>

        @if (Model.Answer is { } answer)
        {
            var tone = answer.Tone switch { ScanTone.Success => "success", ScanTone.Info => "info", _ => "error" };
            <div class="scan-answer @tone" role="status">
                @Icons.Get(answer.Tone == ScanTone.Error ? "x-circle" : answer.Tone == ScanTone.Info ? "info" : "check-circle")
                <div>
                    <h2>@answer.Title</h2>
                    @if (answer.Detail is not null)
                    {
                        <p>@answer.Detail</p>
                    }
                    @if (answer.TrackingCode is not null)
                    {
                        <p class="mono" style="font-size:13px;opacity:.8"><a asp-page="/Hub/Parcel" asp-route-code="@answer.TrackingCode">@answer.TrackingCode</a></p>
                    }
                </div>
            </div>
        }
    </div>
</div>
