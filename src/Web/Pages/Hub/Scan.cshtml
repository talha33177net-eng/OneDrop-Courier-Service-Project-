@page
@model Web.Pages.Hub.ScanModel
@using Domain.Grouping
@using Web.Pages.Hub
@{
    ViewData["Title"] = Model.Current is null ? "Scan parcels" : $"Scan at {Model.Current.Name}";
    var collect = Model.Mode == ScanMode.Collect;
    var load = Model.Mode == ScanMode.Load;
    string Tab(ScanMode mode) => Model.Mode == mode ? "active" : "";
}

@if (Model.Current is null)
{
    <h1>Scan parcels</h1>
    <p class="lead">Which hub are you working for?</p>
    <div class="card">
        <ul class="hub-list">
            @foreach (var hub in Model.Hubs)
            {
                <li><a asp-page="/Hub/Scan" asp-route-hub="@hub.Code">@hub.Name <span class="muted">@hub.Code</span></a></li>
            }
        </ul>
    </div>
    return;
}

<div class="sheet-head">
    <h1>Scan at @Model.Current.Name</h1>
    <span>
        <a asp-page="/Hub/Shelves" asp-route-hub="@Model.Current.Code">Shelves</a> ·
        <a asp-page="/Hub/Shuttle" asp-route-hub="@Model.Current.Code">Shuttle</a>
    </span>
</div>

<nav class="tabs">
    <a asp-page="/Hub/Scan" asp-route-hub="@Model.Current.Code" class="@Tab(ScanMode.Receive)">Receive</a>
    <a asp-page="/Hub/Scan" asp-route-hub="@Model.Current.Code" asp-route-mode="@ScanMode.Load" class="@Tab(ScanMode.Load)">Load the shuttle</a>
    <a asp-page="/Hub/Scan" asp-route-hub="@Model.Current.Code" asp-route-mode="@ScanMode.Collect" class="@Tab(ScanMode.Collect)">Collect at the shop</a>
</nav>

<form method="post" class="card scan-form" asp-route-hub="@Model.Current.Code" asp-route-mode="@Model.Mode">
    <label for="Label">
        @(collect ? "Scan each parcel as you take it from the shop"
            : load ? "Scan each parcel as it goes on the shuttle"
            : "Scan each parcel as it comes in")
    </label>
    <div class="scan-input">
        <input asp-for="Label" type="text" placeholder="OD-100001-1" autocomplete="off" autocapitalize="characters" autofocus />
        <button class="button" type="submit">Scan</button>
    </div>
    <button type="button" class="button secondary" id="camera" hidden>Use the camera</button>
    <video id="preview" playsinline muted hidden></video>
</form>

@if (Model.Problem is { } problem)
{
    <section class="card scan-result scan-problem" role="alert">
        <div class="scan-big">Not scanned</div>
        <p>@problem.Message</p>
    </section>
}
else if (Model.Scan is { } scan)
{
    <section class="card scan-result" role="status">
        @if (collect)
        {
            <div class="scan-big">Collected</div>
            <p>
                <strong>@scan.Order</strong> from @scan.Merchant:
                bring all @scan.Packages @(scan.Packages == 1 ? "package" : "packages") to the hub.
            </p>
        }
        else if (load)
        {
            <div class="scan-label">Load for</div>
            <div class="scan-big">@scan.SendTo hub</div>
        }
        else if (scan.Shelf is { } shelf)
        {
            <div class="scan-label">Shelf</div>
            <div class="scan-big">@shelf</div>
        }
        else if (scan.SendTo is { } sendTo)
        {
            <div class="scan-label">Send on to</div>
            <div class="scan-big">@sendTo hub</div>
        }
        else
        {
            <div class="scan-big">No shelf</div>
            <p>Delivery @scan.Delivery is @scan.DeliveryStatus.ToString().ToLowerInvariant(). Keep the parcel aside for the supervisor.</p>
        }

        @if (scan.AlreadyScanned)
        {
            <p class="notice">This parcel was already scanned@(collect ? " as collected" : load ? " onto the shuttle" : " in here").</p>
        }

        <dl class="scan-facts">
            <div><dt>Parcel</dt><dd>@scan.Label @if (scan.Urgent) { <span class="pill pill-open">Next day</span> }</dd></div>
            <div><dt>Shop</dt><dd>@scan.Merchant</dd></div>
            @if (!collect)
            {
                <div><dt>Order</dt><dd>@scan.Order: @scan.PackagesIn of @scan.Packages @(scan.Packages == 1 ? "package" : "packages") in</dd></div>
            }
            <div>
                <dt>Delivery</dt>
                <dd>
                    @scan.Delivery, @scan.DeliveryDay.ToString("ddd d MMM")
                    @(scan.DeliveryStatus == DeliveryGroupStatus.Open ? "(other shops can still join)" : "")
                </dd>
            </div>
        </dl>
    </section>
}

<script>
    // Phones with a camera QR reader (BarcodeDetector) scan the label directly; others type or use a hand scanner
    (() => {
        const button = document.getElementById('camera');
        if (!('BarcodeDetector' in window) || !navigator.mediaDevices) {
            return;
        }

        button.hidden = false;
        button.addEventListener('click', async () => {
            const detector = new BarcodeDetector({ formats: ['qr_code'] });
            const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
            const video = document.getElementById('preview');
            video.srcObject = stream;
            video.hidden = false;
            await video.play();
            const look = async () => {
                const codes = await detector.detect(video);
                if (codes.length === 0) {
                    requestAnimationFrame(look);
                    return;
                }

                stream.getTracks().forEach(track => track.stop());
                const input = document.getElementById('Label');
                input.value = codes[0].rawValue;
                input.form.submit();
            };
            look();
        });
    })();
</script>
