@page
@model Web.Pages.Hub.RoutesModel
@{
    ViewData["Title"] = "Pickup routes";
}

<p class="eyebrow">Step 1</p>
<h1>Pick up from the shops</h1>
<p class="lead">Each zone's daily run collects the parcels waiting at its shops and brings them to the hub.</p>

<details class="help">
    <summary>How a pickup run works</summary>
    <ol>
        <li>Open the zone's <strong>Route sheet</strong> and print it (or take it on a phone). It lists every shop with parcels.</li>
        <li>At each shop, scan every parcel on the scan page with <strong>Collect at the shop</strong>. Leave any marked "Leave it".</li>
        <li>Back at the hub, scan them in with <strong>Receive at the hub</strong> (step 2).</li>
    </ol>
</details>

<div class="card">
    @if (Model.Routes.Count == 0)
    {
        <p class="muted">No pickup routes are set up yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Zone</th>
                        <th>Hub</th>
                        <th>Next run</th>
                        <th class="num">Stops</th>
                        <th class="num">Orders</th>
                        <th class="num">Packages</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var route in Model.Routes)
                    {
                        <tr>
                            <td><strong>@route.Zone</strong></td>
                            <td>@route.Hub</td>
                            <td>@route.NextPickupDay.ToString("ddd d MMM") at @route.PickupTime.ToString("h:mm tt")</td>
                            <td class="num">@route.Stops</td>
                            <td class="num">@route.Orders</td>
                            <td class="num">@route.Packages</td>
                            <td><a class="button ghost compact" asp-page="/Hub/RouteSheet" asp-route-id="@route.Id">Route sheet</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
