@page
@model Web.Pages.Hub.ShelvesModel
@using Domain.Grouping
@{
    ViewData["Title"] = Model.Current is null ? "Shelves" : $"{Model.Current.Name} shelves";
}

@if (Model.Current is null)
{
    <h1>Shelves</h1>
    <p class="lead">Which hub's shelves?</p>
    <div class="card">
        <ul class="hub-list">
            @foreach (var hub in Model.Hubs)
            {
                <li><a asp-page="/Hub/Shelves" asp-route-hub="@hub.Code">@hub.Name <span class="muted">@hub.Code</span></a></li>
            }
        </ul>
    </div>
    return;
}

<div class="sheet-head">
    <div>
        <h1>@Model.Current.Name shelves</h1>
        <p class="lead">Each delivery waiting here has its own shelf, from its first parcel until a rider takes it out.</p>
    </div>
    <a class="button no-print" asp-page="/Hub/Scan" asp-route-hub="@Model.Current.Code">Scan parcels</a>
</div>

<div class="card">
    @if (Model.Shelves.Count == 0)
    {
        <p class="muted">No delivery is on a shelf yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Shelf</th>
                        <th>Delivery</th>
                        <th>Delivery day</th>
                        <th class="num">Orders</th>
                        <th class="num">Parcels here</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shelf in Model.Shelves)
                    {
                        <tr>
                            <td><strong>@shelf.Shelf</strong></td>
                            <td>@shelf.Delivery</td>
                            <td>@shelf.DeliveryDay.ToString("ddd d MMM")</td>
                            <td class="num">@shelf.Orders</td>
                            <td class="num">@shelf.PackagesHere of @shelf.Packages</td>
                            <td>
                                @if (shelf.Ready)
                                {
                                    <span class="pill pill-ready">Ready</span>
                                }
                                else if (shelf.Status == DeliveryGroupStatus.Open)
                                {
                                    <span class="pill pill-open">Open</span>
                                }
                                else
                                {
                                    <span class="pill">Waiting for parcels</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
