@page
@model Web.Pages.Hub.ShelvesModel
@using Domain.Grouping
@{
    ViewData["Title"] = Model.Current is null ? "Shelves" : $"{Model.Current.Name} shelves";
}

@if (Model.Current is null)
{
    <partial name="_HubPicker" model='new Web.Pages.Hub.HubPicker("/Hub/Shelves", "Shelves", "Which hub are you working at?", Model.Hubs)' />
    return;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Step 3 · @Model.Current.Name</p>
        <h1>Shelves</h1>
        <p class="lead">Each delivery waiting here has its own shelf, from its first parcel until a rider takes it out.</p>
    </div>
    <a class="button no-print" asp-page="/Hub/Scan" asp-route-hub="@Model.Current.Code">Scan parcels in</a>
</div>

<details class="help">
    <summary>What the labels mean</summary>
    <ul>
        <li><span class="pill pill-open">Open</span> other shops can still add orders to this delivery; more parcels may come.</li>
        <li><span class="pill">Waiting for parcels</span> closed, but some parcels are not here yet.</li>
        <li><span class="pill pill-ready">Ready</span> closed and every parcel is on the shelf: it goes out on its delivery day.</li>
    </ul>
</details>

<div class="card">
    @if (Model.Shelves.Count == 0)
    {
        <p class="muted">No delivery is on a shelf yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Shelf</th>
                        <th>Delivery</th>
                        <th>Delivery day</th>
                        <th class="num">Orders</th>
                        <th class="num">Parcels here</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shelf in Model.Shelves)
                    {
                        <tr>
                            <td><strong>@shelf.Shelf</strong></td>
                            <td>@shelf.Delivery</td>
                            <td>@shelf.DeliveryDay.ToString("ddd d MMM")</td>
                            <td class="num">@shelf.Orders</td>
                            <td class="num">@shelf.PackagesHere of @shelf.Packages</td>
                            <td>
                                @if (shelf.Ready)
                                {
                                    <span class="pill pill-ready">Ready</span>
                                }
                                else if (shelf.Status == DeliveryGroupStatus.Open)
                                {
                                    <span class="pill pill-open">Open</span>
                                }
                                else
                                {
                                    <span class="pill">Waiting for parcels</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
