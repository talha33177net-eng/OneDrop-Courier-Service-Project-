@model IReadOnlyList<Application.Network.HubScan.ShuttleParcel>

<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Parcel</th><th>Shop</th><th>Delivery</th><th>Day</th><th class="num">Checked</th></tr>
        </thead>
        <tbody>
            @foreach (var parcel in Model)
            {
                <tr>
                    <td>
                        <strong>@parcel.Label</strong>
                        @if (parcel.Urgent)
                        {
                            <span class="pill pill-open">Next day</span>
                        }
                    </td>
                    <td>@parcel.Merchant</td>
                    <td>@parcel.Delivery</td>
                    <td>@parcel.DeliveryDay.ToString("ddd d MMM")</td>
                    <td class="num">☐</td>
                </tr>
            }
        </tbody>
    </table>
</div>
