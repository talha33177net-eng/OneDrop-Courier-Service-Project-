@page
@model Web.Pages.Hub.IndexModel
@{
    ViewData["Title"] = Model.Hub is null ? "Hub board" : $"{Model.Hub.Name} board";
    var b = Model.Board;
}
@section Head {
    <partial name="_Live" />
}

<div class="page-head">
    <div>
        <h1>@(Model.Hub?.Name ?? "Hub board")</h1>
        <p>@Model.Hub?.Address · <span class="badge badge-brand plain" data-live-status>Live</span></p>
    </div>
    <div class="page-actions">
        @await Html.PartialAsync("_HubSwitch", (Model.Hubs, Model.Hub))
        <a class="btn btn-primary" asp-page="/Hub/Scan" asp-route-hub="@Model.Hub?.Code">@Icons.Get("scan") Scan parcels</a>
    </div>
</div>

@if (b is null)
{
    <div class="card"><div class="empty">@Icons.Get("warehouse")<h3>No hubs yet</h3></div></div>
    return;
}

<div data-live="board">
    <div class="stats">
        <a class="stat" asp-page="/Hub/Pickups" asp-route-hub="@b.Hub.Code">
            <div class="stat-icon amber">@Icons.Get("truck")</div>
            <div><div class="stat-label">Pickups open</div><div class="stat-value">@b.PickupsOpen</div></div>
        </a>
        <div class="stat">
            <div class="stat-icon blue">@Icons.Get("inbox")</div>
            <div><div class="stat-label">Coming from other hubs</div><div class="stat-value">@b.Incoming</div></div>
        </div>
        <a class="stat" asp-page="/Hub/Assign" asp-route-hub="@b.Hub.Code">
            <div class="stat-icon violet">@Icons.Get("send")</div>
            <div><div class="stat-label">Waiting for a rider</div><div class="stat-value">@b.ToAssign.Count</div></div>
        </a>
        <div class="stat">
            <div class="stat-icon">@Icons.Get("route")</div>
            <div><div class="stat-label">To send to other hubs</div><div class="stat-value">@b.ToDispatchCount</div></div>
        </div>
        <a class="stat" asp-page="/Hub/Runs" asp-route-hub="@b.Hub.Code">
            <div class="stat-icon green">@Icons.Get("bike")</div>
            <div><div class="stat-label">Out with riders</div><div class="stat-value">@b.WithRiders</div><div class="stat-sub">@Money.Taka(b.CashWithRiders) cash with riders</div></div>
        </a>
        <div class="stat">
            <div class="stat-icon red">@Icons.Get("return")</div>
            <div><div class="stat-label">To hand back</div><div class="stat-value">@b.ToHandBackCount</div></div>
        </div>
    </div>

    <div class="grid grid-main">
        <div class="card">
            <div class="card-head">
                <div><h2>Waiting for a rider</h2><p>Delivered from this hub</p></div>
                <a class="btn btn-primary btn-sm" asp-page="/Hub/Assign" asp-route-hub="@b.Hub.Code">Assign to riders</a>
            </div>
            @if (b.ToAssign.Count == 0)
            {
                <div class="empty">@Icons.Get("check-circle")<h3>Nothing waiting</h3><p>Parcels for this hub's areas show up here once scanned in.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th>Parcel</th><th>Area</th><th>Merchant</th><th>Status</th><th class="num">COD</th></tr></thead>
                        <tbody>
                            @foreach (var p in b.ToAssign.Take(15))
                            {
                                <tr>
                                    <td><a class="code-link" asp-page="/Hub/Parcel" asp-route-code="@p.TrackingCode">@p.TrackingCode</a><div class="cell-sub">@p.RecipientName</div></td>
                                    <td>@p.Area</td>
                                    <td>@p.Merchant</td>
                                    <td>@Statuses.Badge(p.Status)@if (p.HoldUntil is { } until) { <div class="cell-sub">until @until.ToString("d MMM")</div> }</td>
                                    <td class="num">@Money.Taka(p.CodAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (b.ToAssign.Count > 15)
                {
                    <div class="card-foot muted">And @(b.ToAssign.Count - 15) more.</div>
                }
            }
        </div>

        <div class="stack">
            <div class="card">
                <div class="card-head"><div><h2>Send to other hubs</h2><p>Scan each one in the Dispatch tab</p></div></div>
                @if (b.ToDispatch.Count == 0)
                {
                    <div class="card-body muted">Nothing to send on.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToDispatch)
                                {
                                    <tr>
                                        <td><span class="code-link">@group.HubCode</span> @group.HubName @if (group.Returns) { <span class="badge badge-return plain">Returns</span> }</td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="card">
                <div class="card-head"><div><h2>Hand back to merchants</h2><p>Returns collected by this hub</p></div></div>
                @if (b.ToHandBack.Count == 0)
                {
                    <div class="card-body muted">No returns waiting.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table compact">
                            <tbody>
                                @foreach (var group in b.ToHandBack)
                                {
                                    <tr>
                                        <td><div class="cell-main">@group.Merchant</div><div class="cell-sub">@Money.Phone(group.MerchantPhone)</div></td>
                                        <td class="num strong">@group.Parcels.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
