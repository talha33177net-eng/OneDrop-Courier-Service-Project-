@page
@model Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Become a merchant";
}

<div class="auth-page">
    <div class="auth-card wide">
        <span class="eyebrow">Free to join</span>
        <h1>Create your merchant account</h1>
        <p class="sub">Tell us about your business. @Model.Courier checks new accounts within a working day; you can explore your panel straight away.</p>

        @if (Model.Problem is not null)
        {
            <div class="alert alert-error">@Icons.Get("alert")<div>@Model.Problem</div></div>
        }

        <form method="post">
            <h4 class="mb">Business</h4>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.Business">Business or page name</label>
                    <input asp-for="Input.Business" placeholder="e.g. Dhaka Fashion Corner" />
                    <span asp-validation-for="Input.Business" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Owner">Owner's name</label>
                    <input asp-for="Input.Owner" autocomplete="name" />
                    <span asp-validation-for="Input.Owner" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Phone">Mobile number</label>
                    <input asp-for="Input.Phone" type="tel" placeholder="01712345678" autocomplete="tel" />
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Address">Business address</label>
                    <input asp-for="Input.Address" autocomplete="street-address" />
                    <span asp-validation-for="Input.Address" class="field-error"></span>
                </div>
            </div>

            <h4 class="mb mt">Pickup</h4>
            <div class="form-grid">
                <div class="field">
                    <label for="Input_PickupAreaId">Pickup area</label>
                    @await Html.PartialAsync("_AreaSelect", ("Input.PickupAreaId", Model.Input.PickupAreaId, Model.Areas))
                    <span asp-validation-for="Input.PickupAreaId" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.PickupAddress">Pickup address</label>
                    <input asp-for="Input.PickupAddress" placeholder="Where the rider collects your parcels" />
                    <span asp-validation-for="Input.PickupAddress" class="field-error"></span>
                </div>
            </div>

            <h4 class="mb mt">Sign in details</h4>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                    <span class="hint">At least 8 characters, with a number and upper and lower case letters.</span>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary btn-lg" type="submit">Create account</button>
                <span class="muted">Already a merchant? <a asp-page="/Account/Login">Sign in</a></span>
            </div>
        </form>
    </div>
</div>
