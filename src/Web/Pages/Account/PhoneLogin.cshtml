@page
@model Web.Pages.Account.PhoneLoginModel
@{
    ViewData["Title"] = "Customer sign in";
}

@section Head {
    <partial name="_CustomerApp" />
}

<div class="card narrow">
    <h1>Follow your deliveries</h1>
    @if (!Model.CodeSent)
    {
        <p class="lead">Enter the phone number you give shops at checkout. We will text you a code.</p>
        <form method="post" asp-page-handler="Send">
            <label asp-for="Phone">Mobile number</label>
            <input asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01712345678" />
            <span asp-validation-for="Phone" class="error"></span>
            <button class="button" type="submit">Send code</button>
        </form>
    }
    else
    {
        <p class="lead">We sent a 6-digit code to @Model.Phone. It expires in 5 minutes.</p>
        <form method="post" asp-page-handler="Verify">
            <input asp-for="Phone" type="hidden" />
            <label asp-for="Code">Code</label>
            <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
            <span asp-validation-for="Code" class="error"></span>
            <button class="button" type="submit">Sign in</button>
        </form>
        <form method="post" asp-page-handler="Send">
            <input asp-for="Phone" type="hidden" />
            <button class="button secondary" type="submit">Send a new code</button>
        </form>
    }
</div>
