@page
@model Web.Pages.Account.PhoneLoginModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Customer sign in";
}

@section Head {
    <partial name="_CustomerApp" />
}

<div class="card narrow center">
    <p class="eyebrow">@(Model.CodeSent ? "Step 2 of 2" : "Step 1 of 2")</p>
    <h1>Track my delivery</h1>
    @if (!Model.CodeSent)
    {
        <p class="lead">
            Enter the mobile number you give shops at checkout. We text you a 6-digit code. No account or password is
            needed: your deliveries are already here.
        </p>
        <form method="post" asp-page-handler="Send">
            <label asp-for="Phone">Mobile number</label>
            <input asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01712345678" />
            <span asp-validation-for="Phone" class="error"></span>
            <button class="button block" type="submit">Text me a code</button>
        </form>
    }
    else
    {
        <p class="lead">We sent a 6-digit code to <strong>@Model.Phone</strong>. It expires in 5 minutes.</p>
        @if (Environment.IsDevelopment())
        {
            <p class="notice">Demo mode: no real SMS is sent. Find the code in the <a asp-page="/Dev/Sms" target="_blank">SMS inbox</a>.</p>
        }
        <form method="post" asp-page-handler="Verify">
            <input asp-for="Phone" type="hidden" />
            <label asp-for="Code">Code</label>
            <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
            <span asp-validation-for="Code" class="error"></span>
            <button class="button block" type="submit">Sign in</button>
        </form>
        <form method="post" asp-page-handler="Send">
            <input asp-for="Phone" type="hidden" />
            <button class="button ghost block" type="submit">Didn't get it? Send a new code</button>
        </form>
    }
</div>
