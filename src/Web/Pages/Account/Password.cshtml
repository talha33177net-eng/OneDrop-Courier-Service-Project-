@page
@model Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
    Layout = "_AppLayout";
}

<partial name="_Alerts" />

<div class="page-head">
    <div>
        <h1>Change password</h1>
        <p>Give the password you sign in with now, then the new one twice.</p>
    </div>
</div>

<form method="post" class="card" style="max-width:560px">
    <div class="card-body">
        <div class="field">
            <label asp-for="Input.CurrentPassword">Current password</label>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.NewPassword">New password</label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span class="hint">At least 8 characters, with a capital letter, a small letter and a number.</span>
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </div>
        <div class="field mb-0">
            <label asp-for="Input.ConfirmPassword">New password again</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
    </div>
    <div class="card-foot"><button class="btn btn-primary" type="submit">@Icons.Get("lock") Change password</button></div>
</form>
