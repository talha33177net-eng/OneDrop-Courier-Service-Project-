@page
@model Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Staff sign in";
}

<div class="auth-layout">
    <div class="card">
        <h1>Sign in</h1>
        <p class="lead">For shops, hub staff, riders and admins of @Model.Where.</p>
        <form method="post">
            <div asp-validation-summary="All"></div>
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" autocomplete="username" />
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <label class="check"><input asp-for="Input.RememberMe" /> Keep me signed in</label>
            <button class="button block" type="submit">Sign in</button>
        </form>
        <p class="muted">
            A customer?
            <a asp-page="/Account/PhoneLogin">Track your delivery with your phone number</a> instead: no password needed.
        </p>
    </div>

    @if (Model.DemoLogins.Count > 0)
    {
        <div class="card">
            <h2>Try it with a demo account</h2>
            <p class="muted">
                Development only. Press one to sign in as that person (password <code>@Model.DemoPassword</code>). To
                follow one delivery from start to end, see <a asp-page="/Guide">How it works</a>.
            </p>
            <div class="demo-logins">
                @foreach (var login in Model.DemoLogins)
                {
                    <form method="post">
                        <input type="hidden" name="Input.Email" value="@login.Email" />
                        <input type="hidden" name="Input.Password" value="@Model.DemoPassword" />
                        <button class="demo-login" type="submit">
                            <span>
                                <strong>@login.Name</strong>
                                <small>@login.Email</small>
                            </span>
                            <em>@login.RoleName ›</em>
                        </button>
                    </form>
                }
            </div>
        </div>
    }
</div>
