@page
@model Web.Pages.Dev.PaymentsModel
@using Domain.Payments
@{
    ViewData["Title"] = "Wallet payments";
}

<h1>Wallet payments</h1>
<p class="lead">
    Development only. The fake bKash and Nagad gateway keeps its payment requests here. Press Pay to play the customer
    paying in the app.
</p>

<div class="card table-wrap">
    @if (Model.Requests.Count == 0)
    {
        <p class="muted">No payments requested yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Requested (UTC)</th><th>Wallet</th><th>Amount</th><th>For</th><th>Reference</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.RequestedOn.ToString("HH:mm:ss")</td>
                        <td>@request.Method.DisplayName()</td>
                        <td>৳@request.Amount.ToString("N0")</td>
                        <td>@request.Description</td>
                        <td>@request.Reference</td>
                        <td>
                            @if (request.PaidOn is { } paidOn)
                            {
                                <span class="pill pill-ready">Paid @paidOn.ToString("HH:mm:ss")</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Pay">
                                    <input type="hidden" name="reference" value="@request.Reference" />
                                    <button class="button" type="submit">Pay</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<h2 class="section-title">Payouts to shops</h2>
<div class="card table-wrap">
    @if (Model.Payouts.Count == 0)
    {
        <p class="muted">No payouts sent yet. The settle job pays each shop yesterday's lines.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Sent (UTC)</th><th>To bKash</th><th>Amount</th><th>Payout</th><th>Reference</th></tr>
            </thead>
            <tbody>
                @foreach (var payout in Model.Payouts)
                {
                    <tr>
                        <td>@payout.SentOn.ToString("d MMM HH:mm:ss")</td>
                        <td>@payout.Account</td>
                        <td>৳@payout.Amount.ToString("N0")</td>
                        <td>@payout.Key</td>
                        <td>@payout.Reference</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
