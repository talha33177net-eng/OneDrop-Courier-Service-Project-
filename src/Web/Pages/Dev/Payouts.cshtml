@page
@model Web.Pages.Dev.PayoutsModel
@{
    ViewData["Title"] = "Payouts sent";
}

<div class="page-head">
    <div>
        <h1>Payouts sent</h1>
        <p>Development only. The fake payout gateway lists here what it would have sent to merchants' bKash, Nagad or bank accounts.</p>
    </div>
</div>

<partial name="_Alerts" />

<div class="grid grid-side">
    <div class="card">
        @if (Model.Payouts.Count == 0)
        {
            <div class="empty">@Icons.Get("wallet")<h3>No payouts yet</h3><p>Run them from the admin's Merchant payouts page.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Sent (UTC)</th><th>To</th><th class="num">Amount</th><th>Key</th><th>Reference</th></tr></thead>
                    <tbody>
                        @foreach (var payout in Model.Payouts)
                        {
                            <tr>
                                <td class="nowrap">@payout.SentOn.ToString("d MMM HH:mm:ss")</td>
                                <td>@payout.Account</td>
                                <td class="num">@Money.Taka(payout.Amount)</td>
                                <td><code>@payout.Key</code></td>
                                <td class="cell-sub">@payout.Reference</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="card" style="align-self:start">
        <div class="card-head"><div><h2>Refuse an account</h2><p>To see a stuck payout: transfers to this account fail with your reason until you allow it again. Kept until the app restarts.</p></div></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Refuse">
                <div class="field"><label for="account">Account</label><input type="text" id="account" name="account" placeholder="01712345678" required /></div>
                <div class="field"><label for="reason">Reason the gateway gives</label><input type="text" id="reason" name="reason" placeholder="The receiving account was not found." /></div>
                <button class="btn btn-outline" type="submit">Refuse transfers</button>
            </form>
            @if (Model.Refused.Count > 0)
            {
                <table class="table compact mt">
                    <tbody>
                        @foreach (var (account, reason) in Model.Refused)
                        {
                            <tr>
                                <td><strong>@account</strong><div class="cell-sub">@reason</div></td>
                                <td class="num"><form method="post" asp-page-handler="Allow" class="inline-form"><input type="hidden" name="account" value="@account" /><button class="btn btn-ghost btn-sm" type="submit">Allow</button></form></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
