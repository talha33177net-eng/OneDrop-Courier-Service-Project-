@page
@model Web.Pages.Dev.WebhooksModel
@{
    ViewData["Title"] = "Webhooks received";
}

<div class="page-head"><div><h1>Webhooks received</h1>
<p>
    Development only. A demo merchant sets its webhook on <strong>Webhooks</strong> to
    <code>http://localhost:5080/Dev/Webhooks</code>; this page plays its website and keeps the last 50 updates.
</p></div></div>

<div class="card"><div class="table-wrap">
    @if (Model.Received.Count == 0)
    {
        <div class="empty"><h3>No webhooks yet</h3></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Received (UTC)</th><th>Id</th><th>Signature</th><th>Body</th></tr>
            </thead>
            <tbody>
                @foreach (var (webhook, shop) in Model.Received)
                {
                    <tr>
                        <td>@webhook.On.ToString("HH:mm:ss")</td>
                        <td>@webhook.Id</td>
                        <td>
                            @if (shop is null)
                            {
                                <span class="badge badge-return">Does not check</span>
                            }
                            else
                            {
                                <span class="badge badge-done">Checks: @shop</span>
                            }
                        </td>
                        <td style="white-space: normal"><code>@webhook.Body</code></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</div>
