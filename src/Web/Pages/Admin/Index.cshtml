@page
@model Web.Pages.Admin.IndexModel
@inject ITenantContext TenantContext
@{
    ViewData["Title"] = "Dashboard";
    var d = Model.Data;
    var s = d.Stages;
}
@section Head {
    <partial name="_Live" />
}

<div class="page-head">
    <div>
        <div class="page-kicker">@TenantContext.Require().Local(DateTime.UtcNow).ToString("dddd d MMMM")</div>
        <h1>Dashboard</h1>
        <p>@TenantContext.Tenant?.Name today, across every hub. <span class="badge badge-brand" data-live-status>Live</span></p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-page="/Hub/Choose">@Icons.Get("warehouse") Choose a hub</a>
        <a class="btn btn-outline" asp-page="/Hub/Parcels">@Icons.Get("package") All parcels</a>
        <a class="btn btn-primary" asp-page="/Admin/NewMerchant">@Icons.Get("plus") Add merchant</a>
    </div>
</div>

<div data-live="dashboard">
    @if (d.PendingMerchants > 0)
    {
        <div class="next-step">
            <span class="stat-icon">@Icons.Get("store")</span>
            <div class="next-step-text">
                <strong>@d.PendingMerchants merchant@(d.PendingMerchants == 1 ? "" : "s") waiting for approval</strong>
                <span>They can look around but cannot book parcels until you approve them.</span>
            </div>
            <a class="btn btn-primary" asp-page="/Admin/Merchants" asp-route-status="Pending">Review sign-ups @Icons.Get("arrow-right")</a>
        </div>
    }

    <div class="stats">
        <div class="stat"><div class="stat-icon blue">@Icons.Get("plus")</div><div><div class="stat-label">Booked today</div><div class="stat-value">@d.BookedToday</div></div></div>
        <div class="stat"><div class="stat-icon amber">@Icons.Get("truck")</div><div><div class="stat-label">Picked up today</div><div class="stat-value">@d.PickedUpToday</div></div></div>
        <div class="stat"><div class="stat-icon green">@Icons.Get("check-circle")</div><div><div class="stat-label">Delivered today</div><div class="stat-value">@d.DeliveredToday</div></div></div>
        <div class="stat"><div class="stat-icon red">@Icons.Get("return")</div><div><div class="stat-label">Returned today</div><div class="stat-value">@d.ReturnedToday</div></div></div>
    </div>

    <div class="grid grid-main">
        <div class="card">
            <div class="card-head"><div><h2>Last 7 days</h2><p>Parcels booked, delivered and returned each day</p></div></div>
            <div class="card-body"><partial name="_WeekChart" model="d.Week" /></div>
        </div>
        <div class="card">
            <div class="card-head"><h2>Parcels in progress</h2></div>
            <div class="card-body">
                <div class="money-list">
                    <div><span>@Statuses.Badge(ParcelStatus.Pending)</span><a asp-page="/Hub/Parcels" asp-route-tab="Pending" class="strong">@s.Pending</a></div>
                    <div><span>@Statuses.Badge(ParcelStatus.InTransit)</span><a asp-page="/Hub/Parcels" asp-route-tab="InTransit" class="strong">@s.InTransit</a></div>
                    <div><span>@Statuses.Badge(ParcelStatus.OutForDelivery)</span><a asp-page="/Hub/Parcels" asp-route-tab="OutForDelivery" class="strong">@s.OutForDelivery</a></div>
                    <div><span>@Statuses.Badge(ParcelStatus.OnHold)</span><a asp-page="/Hub/Parcels" asp-route-tab="OnHold" class="strong">@s.OnHold</a></div>
                    <div><span>@Statuses.Badge(ParcelStatus.Returning)</span><a asp-page="/Hub/Parcels" asp-route-tab="Returns" class="strong">@s.Returns</a></div>
                </div>
                <hr />
                <div class="spread">
                    <div>
                        <div class="stat-label">Delivery success</div>
                        <div class="stat-value">@(s.SuccessRate is { } rate ? $"{rate}%" : "—")</div>
                    </div>
                    <div class="ring" style="--value:@(s.SuccessRate ?? 0);width:84px;height:84px"><span style="width:64px;height:64px;font-size:15px">@(s.SuccessRate ?? 0)%</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="stats mt-lg">
        <a class="stat @(d.OpenPickups > 0 ? "attention" : "")" asp-page="/Hub/Choose" asp-route-next="Pickups"><div class="stat-icon amber">@Icons.Get("truck")</div><div><div class="stat-label">Pickups open</div><div class="stat-value">@d.OpenPickups</div></div></a>
        <a class="stat @(d.Late > 0 ? "attention" : "")" asp-page="/Hub/Parcels" asp-route-late="true"><div class="stat-icon red">@Icons.Get("clock")</div><div><div class="stat-label">Late parcels</div><div class="stat-value">@d.Late</div><div class="stat-sub">Past the day they were due</div></div></a>
        <a class="stat" asp-page="/Hub/Choose" asp-route-next="Runs"><div class="stat-icon dark">@Icons.Get("cash")</div><div><div class="stat-label">Cash with riders</div><div class="stat-value">@Money.Taka(d.CashWithRiders)</div></div></a>
        <a class="stat" asp-page="/Admin/Payouts"><div class="stat-icon">@Icons.Get("wallet")</div><div><div class="stat-label">Owed to merchants</div><div class="stat-value">@Money.Taka(d.OwedToMerchants)</div></div></a>
    </div>

    <div class="grid grid-2">
        <div class="card">
            <div class="card-head"><h2>@Icons.Get("warehouse") Hubs</h2><a class="btn btn-ghost btn-sm" asp-page="/Admin/Coverage">Coverage</a></div>
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th>Hub</th><th class="num">At hub</th><th class="num">For riders</th><th class="num">Coming</th><th class="num">With riders</th></tr></thead>
                    <tbody>
                        @foreach (var hub in d.Hubs)
                        {
                            <tr>
                                <td><a asp-page="/Hub/Index" asp-route-hub="@hub.Code"><span class="code-link">@hub.Code</span> @hub.Name</a></td>
                                <td class="num @(hub.AtHub == 0 ? "faint" : "")">@hub.AtHub</td>
                                <td class="num @(hub.ToAssign == 0 ? "faint" : "strong")">@hub.ToAssign</td>
                                <td class="num @(hub.Incoming == 0 ? "faint" : "")">@hub.Incoming</td>
                                <td class="num @(hub.WithRiders == 0 ? "faint" : "")">@hub.WithRiders</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-head"><h2>@Icons.Get("trending") Top merchants this month</h2></div>
            @if (d.TopMerchants.Count == 0)
            {
                <div class="card-body muted">No parcels booked this month yet.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact">
                        <thead><tr><th>Merchant</th><th class="num">Parcels</th><th class="num">Delivered</th></tr></thead>
                        <tbody>
                            @foreach (var merchant in d.TopMerchants)
                            {
                                <tr><td class="cell-main">@merchant.Name</td><td class="num">@merchant.Parcels</td><td class="num">@merchant.Delivered</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
