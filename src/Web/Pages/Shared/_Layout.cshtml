@inject ITenantContext TenantContext
@{
    var tenant = TenantContext.Tenant;
    var signedIn = Context.User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b8f6a" />
    <title>@ViewData["Title"] · @(tenant?.Name ?? "OneDrop")</title>
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    @* Only the taka sign, which Inter lacks *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@500;700&text=%E0%A7%B3&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" href="/">
                <span class="brand-mark">@Icons.Get("package")</span>
                @(tenant?.Name ?? "OneDrop")
            </a>
            @if (tenant is not null)
            {
                <nav class="site-nav" aria-label="Main">
                    <a href="/#services">Services</a>
                    <a href="/#pricing">Pricing</a>
                    <a asp-page="/Coverage">Coverage</a>
                    <a asp-page="/Track">Track a parcel</a>
                </nav>
            }
            <div class="site-actions">
                @if (signedIn)
                {
                    <a class="btn btn-primary" href="/">Go to my panel @Icons.Get("arrow-right")</a>
                }
                else
                {
                    <a class="btn btn-ghost" asp-page="/Account/Login">Sign in</a>
                    @if (tenant is not null)
                    {
                        <a class="btn btn-primary" asp-page="/Account/Register">Become a merchant</a>
                    }
                }
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="site-footer-inner">
            <span>© @DateTime.UtcNow.Year @(tenant?.Name ?? "OneDrop"). Doorstep delivery and cash on delivery across Bangladesh.</span>
            @if (tenant is not null)
            {
                <span>Hotline @tenant.SupportPhone · <a asp-page="/Track">Track a parcel</a> · <a asp-page="/Coverage">Coverage</a></span>
            }
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
