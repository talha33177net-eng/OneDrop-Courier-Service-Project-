@* The rider's screen installs as a phone app like the customer's, opening on today's stops. Plain paths, not ~/: the
   manifest keeps one address across builds *@
<link rel="manifest" href="/rider.webmanifest" />
<link rel="apple-touch-icon" href="/icons/icon-192.png" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="OneDrop rider" />
<script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
</script>
