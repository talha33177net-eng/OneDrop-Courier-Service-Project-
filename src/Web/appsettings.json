{
  "ConnectionStrings": {
    "Database": ""
  },
  "Tenancy": {
    "RootDomain": "onedrop.app"
  },
  "Links": {
    "PortalUrlFormat": "https://{slug}.onedrop.app/"
  },
  "Jobs": {
    "Server": true,
    "LockDueGroups": "*/5 * * * *",
    "PlanTrips": "*/15 * * * *",
    "SettleMerchants": "0 * * * *",
    "OutboxInterval": "00:00:05"
  },
  "Webhooks": {
    "Timeout": "00:00:10"
  },
  "Seed": {
    "DemoData": false,
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
